# انسخ هذا الملف باسم .env وعبّئ القيم عند تجهيز السيرفر

PORT=4000

# مفتاح Anthropic (Claude) - يُستخدم في كل الخدمات التي تحتاج ذكاء اصطناعي:
# الترجمة، تفريغ الخط اليدوي، محضر الاجتماع، تحليل مخاطر العقود، فرز السير الذاتية...
ANTHROPIC_API_KEY=

# مجلدات العمل (تُنشأ تلقائياً إن لم تكن موجودة)
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# حد أقصى لحجم الملف المرفوع بالميجابايت
MAX_FILE_SIZE_MB=50
